# Copiar a .env y completar. El .env no se versiona ni se pega en chats.
# FL0 solo necesita lo de pruebas; el canal, los modelos y la operación se definen en FL1.

# --- Base (Postgres con pgvector) ---
DATABASE_URL=                  # sin ella, el motor corre en memoria y nada persiste
MIND_KEY=                      # clave de cifrado en reposo (32 bytes en base64). Con base persistente es obligatoria.

# --- Pruebas ---
TEST_DATABASE_URL=             # base desechable con las migraciones aplicadas; sin ella, la prueba sobre Postgres se salta
